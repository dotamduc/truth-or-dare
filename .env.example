# Environment variables for Truth or Dare Vietnam

# Database connection URL (SQLite local dev / PostgreSQL in production)
DATABASE_URL="file:./dev.db"

# Admin Secret / JWT Key
ADMIN_JWT_SECRET="truth-or-dare-vietnam-super-secret-jwt-key-change-in-production-2026"
ADMIN_DEFAULT_USER="admin"
ADMIN_DEFAULT_PASS="admin123456"

# App configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
