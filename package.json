{
  "name": "truth-or-dare-vietnam",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:pages": "cross-env GITHUB_PAGES=true next build",
    "start": "serve out -l 3000",
    "preview:pages": "tsx scripts/prepare-pages-preview.ts && serve .pages-preview -l 3000",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:pages": "playwright test -c playwright.pages.config.ts",
    "content:import": "tsx scripts/import-question-file.ts",
    "content:audit": "tsx scripts/audit-prompts.ts",
    "verify": "pnpm content:audit && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm build:pages && pnpm test:e2e:pages"
  },
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.0",
    "@vercel/analytics": "^2.0.1",
    "canvas-confetti": "1.9.4",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.2.12",
    "@playwright/test": "1.62.0",
    "@types/canvas-confetti": "1.9.0",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.5.4",
    "cross-env": "10.1.0",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "postcss": "8.5.25",
    "serve": "14.2.6",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
